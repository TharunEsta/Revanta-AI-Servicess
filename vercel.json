{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/jobs/process-reminders",
      "schedule": "* * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/go",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/quote",
      "destination": "/#contact",
      "permanent": true
    }
  ]
}
